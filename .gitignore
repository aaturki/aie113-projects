# Python and notebooks
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/

# Made by running a starter notebook: downloads and trained models stay out of git.
# (Deciding where your service's model lives is part of Stage 3.)
tracks/*/artifacts/
tracks/*/data/
*.onnx
*.safetensors

# Secrets: never commit these
.env
*.agekey
age-key.txt
keys.txt

# The service's model and data: trained and downloaded by the pipeline, never committed.
# Anchored with / so they match only the top-level folders, not tests/data/.
/artifacts/
/data/

# Made by pip install -e .
*.egg-info/
build/
dist/
