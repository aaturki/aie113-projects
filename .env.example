# The service's settings, for a local run. Copy this file to .env (git ignores .env) and change
# what you need. Every setting is explained in src/fraud_alerts/config.py.
FRAUD_MODEL_DIR=artifacts
FRAUD_BLOCK_THRESHOLD=0.9
FRAUD_BANK_TIMEZONE=Asia/Riyadh
FRAUD_LOG_LEVEL=INFO

# The fraud team's webhook: set both, or neither.
# FRAUD_ALERT_WEBHOOK_URL=https://fraud-team.example/alerts
#
# The token is a SECRET. Never write it here, in a commit, an image or a log. Give it as a
# file instead: in a container, as /run/secrets/fraud_alert_webhook_token (compose.smoke.yaml
# shows how); on a server, from the platform's secret store, mounted at the same place.
